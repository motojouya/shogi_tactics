  "author": "Takuya Sugiyama @motojouya",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/motojouya/shogi_tactics/issues"
  },
  "homepage": "https://github.com/motojouya/shogi_tactics#readme",
  "private": true,
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.1",
